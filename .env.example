# Defaults from the source code. Select the API endpoint for your event.
API_DEFAULT_URL=https://scores.frisbee.pl/test3/ext/watchlive.php/
API_DEFAULT_HEADERS='{"Content-Type": "application/x-www-form-urlencoded; charset=UTF-8"}'

MAX_CONNECTIONS=100
CACHE_TTL=5
REQUEST_TIMEOUT=30
OUTPUT_PATH=output
GAME_DURATION=25

# Optional live WebSocket output (overlay files are maintained in both modes).
ENABLE_WEBSOCKET=false
WEBSOCKET_HOST=localhost
WEBSOCKET_PORT=8765
# API polling interval in seconds.
POLL_INTERVAL=2
